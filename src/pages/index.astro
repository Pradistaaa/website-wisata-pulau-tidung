  padding: 18px;
  background: white;
  border: 1px solid #dce8e4;
  border-radius: 16px;
}

.bank-label {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 1.5px;
  color: #0a817b;
}

.bank-name {
  margin-top: 14px;
  font-size: 14px;
  font-weight: 850;
  color: #173d40;
}

.bank-account {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 8px;
}

.bank-account strong {
  font-size: 22px;
  letter-spacing: 1px;
  color: #073f43;
  overflow-wrap: anywhere;
}

.copy-account {
  flex-shrink: 0;
  border: 0;
  padding: 9px 12px;
  border-radius: 9px;
  background: #0a817b;
  color: white;
  font-size: 11px;
  font-weight: 800;
  cursor: pointer;
  transition: 0.2s;
}

.copy-account:hover {
  background: #076b66;
  transform: translateY(-1px);
}

.copy-account.copied {
  background: #16a56e;
}

@media (max-width: 480px) {
  .bank-account {
    align-items: stretch;
    flex-direction: column;
  }

  .bank-account strong {
    font-size: 19px;
  }

  .copy-account {
    width: 100%;
  }
}

  /* ================= FOOTER ================= */

  footer {
    background: #052f32;
    color: rgba(255, 255, 255, 0.6);
  }

  .footer-inner {
    width: min(1180px, 100%);
    margin: auto;
    padding: 35px 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    font-size: 11px;
  }

