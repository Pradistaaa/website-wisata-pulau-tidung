.package-section {
  width: 100%;
  background: #f5f8f6;
  padding: 110px 30px;
}

.package-inner {
  width: min(1180px, 100%);
  margin: auto;
}

.package-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 50px;
}

.package-heading h2 {
  margin-top: 17px;
  max-width: 650px;
}

.package-heading > p {
  max-width: 390px;
  color: #718080;
  font-size: 14px;
}

.package-card {
  margin-top: 50px;
  padding: 38px;
  border-radius: 28px;
  background: #0a5054;
  color: white;
  box-shadow: 0 25px 60px rgba(0, 50, 52, 0.14);
}

.package-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 30px;
}

.package-tag {
  display: inline-block;
  color: #e4bd7c;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 2px;
  margin-bottom: 12px;
}

.package-top h3 {
  font-size: clamp(27px, 4vw, 40px);
  line-height: 1.05;
  letter-spacing: -1.5px;
}

.package-top p {
  max-width: 500px;
  margin-top: 12px;
  color: rgba(255, 255, 255, 0.68);
  font-size: 13px;
}

.package-duration {
  min-width: 100px;
  text-align: right;
}

.package-duration strong {
  display: block;
  color: #e4bd7c;
  font-size: 32px;
  line-height: 1;
}

.package-duration span {
  display: block;
  margin-top: 7px;
  color: rgba(255, 255, 255, 0.5);
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 1.5px;
}

.package-divider {
  height: 1px;
  margin: 32px 0;
  background: rgba(255, 255, 255, 0.13);
}

.package-content {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 35px;
}

.package-column {
  min-width: 0;
}

.package-label {
  display: block;
  margin-bottom: 15px;
  color: #e4bd7c;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.8px;
}

.package-column ul {
  list-style: none;
}

.package-column li {
  position: relative;
  padding-left: 17px;
  margin-bottom: 9px;
  color: rgba(255, 255, 255, 0.76);
  font-size: 13px;
}

.package-column li::before {
  content: "•";
  position: absolute;
  left: 0;
  color: #d8ad6c;
}

.package-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  margin-top: 35px;
  padding-top: 25px;
  border-top: 1px solid rgba(255, 255, 255, 0.13);
}

.package-bottom > div {
  display: flex;
  flex-direction: column;
}

.package-bottom span {
  color: rgba(255, 255, 255, 0.45);
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 1.5px;
}

.package-bottom strong {
  margin-top: 4px;
  font-size: 13px;
  font-weight: 700;
}

.package-button {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  min-height: 48px;
  padding: 0 18px;
  border-radius: 11px;
  background: #19a875;
  color: white;
  font-size: 12px;
  font-weight: 850;
  white-space: nowrap;
  transition: 0.25s;
}

.package-button:hover {
  transform: translateY(-2px);
}

/* ================= PAKET MOBILE ================= */

@media (max-width: 850px) {
  .package-section {
    padding: 75px 20px;
  }

  .package-heading {
    display: block;
  }

  .package-heading > p {
    margin-top: 20px;
  }

  .package-card {
    margin-top: 35px;
    padding: 26px;
    border-radius: 22px;
  }

  .package-top {
    display: block;
  }

  .package-duration {
    margin-top: 25px;
    text-align: left;
  }

  .package-duration strong {
    font-size: 27px;
  }

  .package-divider {
    margin: 26px 0;
  }

  .package-content {
    grid-template-columns: 1fr;
    gap: 25px;
  }

  .package-bottom {
    align-items: stretch;
    flex-direction: column;
  }

  .package-button {
    width: 100%;
  }
}

@media (max-width: 480px) {
  .package-section {
    padding: 65px 16px;
  }

  .package-card {
    padding: 22px;
  }

  .package-top h3 {
    font-size: 27px;
  }

  .package-column li {
    font-size: 12px;
  }
}

