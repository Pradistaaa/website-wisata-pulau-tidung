---
const waNumber = "6281383566717";

const waHero = `https://wa.me/${waNumber}?text=${encodeURIComponent(
  "Halo Wisata Pulau Tidung, saya ingin tanya ketersediaan dan harga kamar."
)}`;

const waBooking = `https://wa.me/${waNumber}?text=${encodeURIComponent(
  "Halo Wisata Pulau Tidung, saya ingin booking. Mohon info ketersediaan dan harga kamar."
)}`;

const mapsUrl =
  "https://www.google.com/maps/search/?api=1&query=Homestay%20Mojol%20Tea%2C%20Pulau%20Harapan";

  const bankName = "BRI";
const accountNumber = "139601001958505";
---

<!doctype html>
<html lang="id">
  <head>

    <link rel="icon" type="image/png" href="/faviconmojoltea.png" />

    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />

    <title>Homestay Wisata Pulau Tidung| Kepulauan Seribu</title>

    <meta
      name="description"
      content="Homestay Wisata Pulau Tidung di Kepulauan Seribu. Tempat nyaman untuk menikmati suasana pulau, snorkeling, island hopping, dan liburan bersama orang terdekat."
    />

    <meta
      name="keywords"
      content="Homestay Wisata Pulau Tidung, Homestay Pulau Harapan, Penginapan Pulau Harapan, Kepulauan Seribu"
    />

    <meta name="theme-color" content="#0b4f52" />
  </head>

  <body>
    <!-- ================= NAVBAR ================= -->
    <nav class="navbar">
      <div class="nav-inner">
        <a href="#" class="logo">
  <img src="/faviconmojoltea.png" alt="Logo Wisata Pulau Tidung" />
  <span class="logo-text">WISATA PULAU <b>TIDUNG</b></span>
</a>

        <div class="nav-links">
          <a href="#tentang">Tentang</a>
          <a href="#pengalaman">Pengalaman</a>
          <a href="#galeri">Galeri</a>
          <a href="#video">Video</a>
          <a href="#lokasi">Lokasi</a>
          <a href="#booking">Booking</a>
        </div>

        <a
          href={waHero}
          target="_blank"
          rel="noopener noreferrer"
          class="nav-cta"
        >
          WhatsApp
        </a>
      </div>
    </nav>

    <!-- ================= HERO ================= -->
    <header class="hero">
      <div class="hero-overlay"></div>

      <div class="hero-content">
        <div class="hero-location">
          <span></span>
          PULAU TIDUNG · KEPULAUAN SERIBU
        </div>

        <h1>
          Nikmati Pulau.
          <br />
          <em>Tinggal Lebih Nyaman.</em>
        </h1>

        <p>
          Temukan tempat beristirahat yang nyaman untuk menikmati suasana
          tropis Pulau Tidung, laut yang indah, snorkeling, dan island
          hopping.
        </p>

        <div class="hero-actions">
          <a
            href={waHero}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            <span>💬</span>
            Reservasi via WhatsApp
          </a>

          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
          >
            Lihat Lokasi
            <span>↗</span>
          </a>
        </div>

        <div class="hero-note">
          <span>✦</span>
          Tanyakan ketersediaan kamar & harga terbaru
        </div>
      </div>

      <a href="#tentang" class="scroll-down">
        <span>Scroll untuk menjelajah</span>
        ↓
      </a>
    </header>

    <!-- ================= TENTANG ================= -->
    <section id="tentang" class="intro section">
      <div class="intro-label">
        <span>01</span>
        TENTANG Wisata Pulau Tidung
      </div>

      <div class="intro-grid">
        <div>
          <h2>
            Tempat sederhana untuk
            <span> momen yang luar biasa.</span>
          </h2>
        </div>

        <div class="intro-text">
          <p>
            Wisata Pulau Tidung hadir sebagai pilihan tempat menginap ketika kamu ingin
            menikmati suasana Pulau Tidung dengan lebih santai.
          </p>

          <p>
            Setelah seharian menikmati laut dan menjelajahi pulau, kembali ke
            tempat yang nyaman untuk beristirahat dan menikmati suasana
            kepulauan.
          </p>

          <a href="#booking" class="text-link">
            Rencanakan perjalananmu
            <span>→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ================= PENGALAMAN ================= -->
    <section id="pengalaman" class="experience section">
      <div class="section-heading">
        <div>
          <div class="intro-label">
            <span>02</span>
            PENGALAMAN
          </div>

          <h2>
            Lebih dari sekedar
            <span> tempat menginap.</span>
          </h2>
        </div>

        <p>
          Pulau Tidung menawarkan pengalaman wisata bahari yang cocok untuk
          liburan singkat maupun perjalanan bersama orang terdekat.
        </p>
      </div>

      <div class="experience-grid">
        <article class="experience-card pulau-harapan">
          <div class="card-number">01</div>
          <div class="card-icon">🏝️</div>

          <h3>Pulau Tidung</h3>

          <p>
            Nikmati suasana tropis dan pesona kepulauan yang jauh dari
            hiruk-pikuk kota.
          </p>

          <div class="card-line"></div>
        </article>

        <article class="experience-card wisata-bahari">
          <div class="card-number">02</div>
          <div class="card-icon">🌊</div>

          <h3>Wisata Bahari</h3>

          <p>
            Jelajahi laut, menikmati sunset, snorkeling, dan perjalanan island
            hopping.
          </p>

          <div class="card-line"></div>
        </article>

        <article class="experience-card waktu-beristirahat">
          <div class="card-number">03</div>
          <div class="card-icon">🛏️</div>

          <h3>Waktu Beristirahat</h3>

          <p>
            Setelah beraktivitas seharian, nikmati waktu santai sebelum kembali
            menjelajahi pulau.
          </p>

          <div class="card-line"></div>
        </article>
      </div>
    </section>

    <!-- ================= PAKET WISATA ================= -->
<section id="paket" class="package-section">
  <div class="package-inner">

    <div class="package-heading">
      <div>
        <div class="intro-label">
          <span>03</span>
          PAKET WISATA
        </div>

        <h2>
          Paket Wisata
          <span> 2H1M.</span>
        </h2>
      </div>

      <p>
        Nikmati pengalaman menginap sekaligus menjelajahi keindahan
        Pulau Tidung dalam perjalanan 2 hari 1 malam.
      </p>
    </div>

    <div class="package-card">

      <div class="package-top">
        <div>
          <span class="package-tag">PAKET POPULER</span>
          <h3>Wisata 2 Hari 1 Malam</h3>
          <p>
            Cocok untuk liburan bersama keluarga, pasangan,
            maupun teman.
          </p>
        </div>

        <div class="package-duration">
          <strong>2H1M</strong>
          <span>PERJALANAN</span>
        </div>
      </div>

      <div class="package-divider"></div>

      <div class="package-content">

        <div class="package-column">
          <span class="package-label">AKTIVITAS</span>

          <ul>
            <li>Snorkeling</li>
            <li>Island hopping</li>
            <li>Menikmati sunset</li>
            <li>Underwater photography</li>
            <li>Berenang & bermain di laut</li>
          </ul>
        </div>

        <div class="package-column">
          <span class="package-label">DESTINASI</span>

          <ul>
            <li>Pulau Genteng</li>
            <li>Pulau Macan</li>
            <li>Pulau Bintang</li>
            <li>Pulau Bulat</li>
            <li>Pulau Gosong</li>
          </ul>
        </div>

        <div class="package-column">
          <span class="package-label">PENGALAMAN</span>

          <ul>
            <li>Penangkaran penyu</li>
            <li>Wisata mangrove</li>
            <li>BBQ</li>
            <li>Dokumentasi perjalanan</li>
            <li>Konservasi laut</li>
          </ul>
        </div>

      </div>

      <div class="package-bottom">
        <div>
          <span>INFO PAKET</span>
          <strong>Hubungi Wisata Pulau Tidung untuk harga terbaru</strong>
        </div>

        <a
          href={waBooking}
          target="_blank"
          rel="noopener noreferrer"
          class="package-button"
        >
          Tanya Paket
          <span>↗</span>
        </a>
      </div>

    </div>
  </div>
</section>

<!-- ================= DESTINASI & AKTIVITAS ================= -->
<section id="destinasi" class="destinations-section">

  <div class="destinations-inner">

    <div class="destinations-heading">
      <div>
        <div class="intro-label">
          <span>04</span>
          DESTINASI & AKTIVITAS
        </div>

        <h2>
          Jelajahi lebih banyak
          <span> pengalaman.</span>
        </h2>
      </div>

      <p>
        Selain menikmati Pulau Tidung, nikmati juga berbagai pilihan
        destinasi dan aktivitas menarik di kawasan Kepulauan Seribu.
      </p>
    </div>

    <div class="destinations-grid">

      <article class="destination-card">
        <div class="destination-image">
  <a
    href="/images/tidung.jpg"
    target="_blank"
    rel="noopener noreferrer"
  >
    <img src="/images/tidung.jpg" alt="Pulau Tidung">
  </a>
</div>

        <div class="destination-content">
          <span>PULAU</span>
          <h3>Pulau Tidung</h3>
          <p>
            Nikmati keindahan Pulau Tidung dengan pantai yang indah,
            snorkeling, serta Jembatan Cinta yang menjadi salah satu
            ikon wisata di pulau ini.
          </p>
        </div>
      </article>

      <article class="destination-card">
        <div class="destination-image">
  <a
    href="/images/pari.jpg"
    target="_blank"
    rel="noopener noreferrer"
  >
    <img src="/images/pari.jpg" alt="Pulau Pari">
  </a>
</div>

        <div class="destination-content">
          <span>PULAU</span>
          <h3>Pulau Pari</h3>
          <p>
            Bersantai di Pantai Pasir Perawan, menikmati suasana pantai,
            snorkeling, dan menjelajahi keindahan alam Pulau Pari.
          </p>
        </div>
      </article>

      <article class="destination-card">
      <div class="destination-image">
  <a
    href="/images/pramuka.jpg"
    target="_blank"
    rel="noopener noreferrer"
  >
    <img src="/images/pramuka.jpg" alt="Pulau Pramuka">
  </a>
</div>

        <div class="destination-content">
          <span>PULAU</span>
          <h3>Pulau Pramuka</h3>
          <p>
            Jelajahi wisata bahari, snorkeling, mangrove, serta pengalaman
            wisata edukasi dan konservasi di Pulau Pramuka.
          </p>
        </div>
      </article>

      <article class="destination-card">
        <div class="destination-image">
  <a
    href="/images/mancing.jpg"
    target="_blank"
    rel="noopener noreferrer"
  >
    <img src="/images/mancing.jpg" alt="Wisata Mancing">
  </a>
</div>

        <div class="destination-content">
          <span>AKTIVITAS</span>
          <h3>Wisata Mancing</h3>
          <p>
            Rasakan pengalaman memancing di perairan Kepulauan Seribu
            sambil menikmati suasana laut dan perjalanan bersama teman
            maupun keluarga.
          </p>
        </div>
      </article>

      <article class="destination-card">
       <div class="destination-image">
  <a
    href="/images/camping.jpg"
    target="_blank"
    rel="noopener noreferrer"
  >
    <img src="/images/camping.jpg" alt="Camping">
  </a>
</div>

        <div class="destination-content">
          <span>ADVENTURE</span>
          <h3>Camping</h3>
          <p>
            Nikmati suasana malam yang lebih dekat dengan alam melalui
            pengalaman camping dengan pemandangan dan udara laut.
          </p>
        </div>
      </article>

    </div>

  </div>

</section>
<!-- ================= END DESTINASI & AKTIVITAS ================= -->

<!-- ================= WATER SPORT ================= -->
<section id="watersport" class="watersport-section">

  <div class="watersport-inner">

    <div class="watersport-heading">
      <div>
        <div class="intro-label">
          <span>05</span>
          WATER SPORT
        </div>

        <h2>
          Serunya bermain
          <span> di laut.</span>
        </h2>
      </div>

      <p>
        Lengkapi liburan di Pulau Tidung dengan berbagai aktivitas
        water sport yang bisa dinikmati bersama keluarga maupun teman.
      </p>
    </div>

    <div class="watersport-grid">

      <article class="watersport-card banana-boat">
        <div class="watersport-number">01</div>

        <div class="watersport-icon">🚤</div>

        <div class="watersport-info">
          <span>ADRENALINE</span>
          <h3>Banana Boat</h3>
          <p>
            Rasakan keseruan melaju di atas laut bersama orang-orang
            terdekat.
          </p>
        </div>
      </article>

      <article class="watersport-card donut-boat">
        <div class="watersport-number">02</div>

        <div class="watersport-icon">🛟</div>

        <div class="watersport-info">
          <span>FUN RIDE</span>
          <h3>Donut Boat</h3>
          <p>
            Aktivitas seru di laut untuk menambah kesan liburan.
          </p>
        </div>
      </article>

      <article class="watersport-card jetski">
        <div class="watersport-number">03</div>

        <div class="watersport-icon">🌊</div>

        <div class="watersport-info">
          <span>EXPLORING</span>
          <h3>Jetski</h3>
          <p>
            Nikmati sensasi melaju menyusuri perairan Pulau Harapan.
          </p>
        </div>
      </article>

      <article class="watersport-card paddleboard">
        <div class="watersport-number">04</div>

        <div class="watersport-icon">🏄</div>

        <div class="watersport-info">
          <span>RELAXING</span>
          <h3>Paddleboard</h3>
          <p>
            Menikmati laut dengan aktivitas yang lebih santai dan tenang.
          </p>
        </div>
      </article>

      <article class="watersport-card kano-bening">
        <div class="watersport-number">05</div>

        <div class="watersport-icon">🛶</div>

        <div class="watersport-info">
          <span>ADVENTURE</span>
          <h3>Kano Bening</h3>
          <p>
            Nikmati pemandangan bawah laut melalui kano dengan dasar bening.
          </p>
        </div>
      </article>

    </div>

    <div class="watersport-note">
      <span>✦</span>
      Ketersediaan aktivitas dapat menyesuaikan kondisi cuaca dan laut.
    </div>

  </div>

</section>

<!-- ================= RUNDOWN 2H1M ================= -->
<section id="rundown" class="rundown-section">
  <div class="rundown-inner">

    <div class="rundown-heading">
      <div>
        <div class="intro-label">
          <span>06</span>
          RUNDOWN PERJALANAN
        </div>

        <h2>
          Dua hari untuk
          <span> menikmati pulau.</span>
        </h2>
      </div>

      <p>
        Nikmati rangkaian aktivitas selama berada di Pulau Tidung.
        Rundown dapat menyesuaikan kondisi cuaca dan situasi di lapangan.
      </p>
    </div>

    <div class="rundown-timeline">

      <!-- HARI 1 -->
      <article class="rundown-day">
        <div class="rundown-day-head">
          <div class="rundown-day-number">01</div>

          <div>
            <span>HARI PERTAMA</span>
            <h3>Explore & Enjoy</h3>
          </div>
        </div>

        <div class="rundown-items">

          <div class="rundown-item">
            <div class="rundown-time">PAGI</div>
            <div class="rundown-dot"></div>
            <div>
              <h4>Tiba di Pulau Tidung</h4>
              <p>
                Kedatangan dan persiapan sebelum memulai perjalanan wisata.
              </p>
            </div>
          </div>

          <div class="rundown-item">
            <div class="rundown-time">SIANG</div>
            <div class="rundown-dot"></div>
            <div>
              <h4>Snorkeling & Island Hopping</h4>
              <p>
                Menjelajahi spot wisata bahari dan menikmati keindahan
                perairan Kepulauan Seribu.
              </p>
            </div>
          </div>

          <div class="rundown-item">
            <div class="rundown-time">SORE</div>
            <div class="rundown-dot"></div>
            <div>
              <h4>Sunset & Waktu Santai</h4>
              <p>
                Menikmati suasana sore, kembali ke penginapan dan
                mempersiapkan aktivitas malam.
              </p>
            </div>
          </div>

          <div class="rundown-item">
            <div class="rundown-time">MALAM</div>
            <div class="rundown-dot"></div>
            <div>
              <h4>BBQ & Istirahat</h4>
              <p>
                Menikmati makan malam dan suasana santai bersama
                sebelum beristirahat.
              </p>
            </div>
          </div>

        </div>
      </article>

      <!-- HARI 2 -->
      <article class="rundown-day">
        <div class="rundown-day-head">
          <div class="rundown-day-number">02</div>

          <div>
            <span>HARI KEDUA</span>
            <h3>Adventure & Memories</h3>
          </div>
        </div>

        <div class="rundown-items">

          <div class="rundown-item">
            <div class="rundown-time">PAGI</div>
            <div class="rundown-dot"></div>
            <div>
              <h4>Waktu Bebas & Sarapan</h4>
              <p>
                Menikmati pagi di Pulau Tidung sebelum melanjutkan
                aktivitas berikutnya.
              </p>
            </div>
          </div>

          <div class="rundown-item">
            <div class="rundown-time">SIANG</div>
            <div class="rundown-dot"></div>
            <div>
              <h4>Aktivitas Bahari</h4>
              <p>
                Melanjutkan pengalaman wisata dengan aktivitas laut
                sesuai paket dan kondisi cuaca.
              </p>
            </div>
          </div>

          <div class="rundown-item">
            <div class="rundown-time">SIANG</div>
            <div class="rundown-dot"></div>
            <div>
              <h4>Persiapan Pulang</h4>
              <p>
                Kembali ke Pulau Tidung dan mempersiapkan perjalanan
                menuju Jakarta.
              </p>
            </div>
          </div>

        </div>
      </article>

    </div>

    <div class="rundown-note">
      <span>✦</span>
      Rundown dapat berubah mengikuti cuaca, kondisi laut, dan situasi alam.
    </div>

  </div>
</section>

<!-- ================= FASILITAS ================= -->
