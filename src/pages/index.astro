    font-size: 18px;
    font-weight: 900;
  }

  .footer-copy {
    opacity: 0.6;
  }

  /* ================= FLOATING WHATSAPP ================= */

  .floating-wa {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-radius: 50px;
    background: #16a56e;
    color: white;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.22);
