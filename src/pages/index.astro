    font-size: 11px;
  }

  /* ================= TABLET ================= */

  @media (max-width: 1024px) {
    .nav-links {
      gap: 15px;
      font-size: 12px;
    }

    .nav-inner {
      padding-left: 24px;
      padding-right: 24px;
    }

    .intro-grid {
      gap: 50px;
    }

    .location-inner,
    .booking-inner {
      gap: 45px;
    }

    .experience-grid {
      grid-template-columns: repeat(2, 1fr);
